{
  "name": "vibe-tavern",
  "version": "1.0.1",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "trustedDependencies": [
    "@tailwindcss/oxide",
    "lightningcss",
    "rolldown"
  ],
  "resolutions": {
    "@codemirror/state": "6.7.0"
  },
  "scripts": {
    "build": "bun run build:api-stack && bun run --filter @vibe-tavern/web build",
    "build:web": "bun scripts/build-web.ts",
    "build:api-stack": "bun scripts/build.ts api-stack",
    "build:prod": "bun scripts/build.ts api-stack",
    "build:standalone": "bun scripts/build-standalone.ts",
    "build:android-arm64": "bun scripts/build-android-arm64.ts",
    "build:linux-dist": "bun scripts/build-linux-dist.ts",
    "build:windows-dist": "bun scripts/build-windows-dist.ts",
    "build:installer": "bun scripts/build-installer.ts",
    "dev": "bun scripts/dev.ts",
    "preview": "bun run build && bun services/api/src/server/prod-server.ts",
    "typecheck": "bun scripts/type-gate.ts && bun run --filter '*' typecheck",
    "test": "bun scripts/test.ts",
    "test:verbose": "bun test scripts && bun run --filter '*' test",
    "test:parallel": "bun test --parallel",
    "i18n:check": "cd apps/web && bunx i18next-cli extract --ci && bunx i18next-cli status",
    "i18n:lint": "cd apps/web && bunx i18next-cli lint",
    "check": "bun run typecheck && bun run test && bun run i18n:check",
    "dev:api": "bun run --filter @vibe-tavern/api dev",
    "dev:web": "bun run --filter @vibe-tavern/web dev",
    "dev:web:debug": "bun run --filter @vibe-tavern/web dev:debug",
    "db:generate": "bun run --filter @vibe-tavern/db db:generate",
    "db:push": "bun run --filter @vibe-tavern/db db:push",
    "bump-version": "bun scripts/bump-version.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/pngjs": "^6.0.5",
    "bun-plugin-tailwind": "^0.1.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "hono": "^4.12.28",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.1.4",
    "zustand": "^5.0.14"
  },
  "optionalDependencies": {
    "@rolldown/binding-win32-x64-msvc": "1.1.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Noineri/vibe_tavern"
  },
  "license": "AGPL-3.0"
}
