{
  "name": "vibe-tavern",
  "version": "1.2.1",
  "private": true,
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "resolutions": {
    "@codemirror/state": "6.7.4",
    "@codemirror/view": "^6.43.11",
    "@codemirror/language": "^6.12.4",
    "brace-expansion": "^5.0.9"
  },
  "scripts": {
    "build": "bun run build:api-stack && bun run --filter @vibe-tavern/web build",
    "build:web": "bun scripts/build-web.ts",
    "build:api-stack": "bun scripts/build.ts api-stack",
    "build:prod": "bun scripts/build.ts api-stack",
    "build:standalone": "bun scripts/build-standalone.ts",
    "build:android-native": "bun scripts/build-android-native.ts",
    "build:linux-dist": "bun scripts/build-linux-dist.ts",
    "build:windows-dist": "bun scripts/build-windows-dist.ts",
    "build:installer": "bun scripts/build-installer.ts",
    "build:npm-dist": "bun scripts/build-npm-dist.ts",
    "dev": "bun apps/web/dev-server.ts",
    "prod": "bun run build && bun services/api/src/server/prod-server.ts",
    "typecheck": "bun scripts/type-gate.ts && bunx tsc -p scripts/tsconfig.json && bun run --filter '*' typecheck",
    "test": "bun scripts/test.ts",
    "test:verbose": "bun test scripts && bun run --filter '*' test",
    "i18n:types": "cd apps/web && bunx i18next-cli types",
    "i18n:check": "cd apps/web && bunx i18next-cli extract --ci && bunx i18next-cli status",
    "i18n:lint": "cd apps/web && bunx i18next-cli lint",
    "check": "bun run test:hygiene && bun run i18n:types && bun run typecheck && bun run test && bun run i18n:check",
    "test:hygiene": "bun run scripts/test-hygiene.ts",
    "dev:api": "bun run --filter @vibe-tavern/api dev",
    "dev:web": "bun apps/web/dev-server.ts --no-api",
    "db:generate": "bun run --filter @vibe-tavern/db db:generate",
    "gen:experience-frame-runtime": "bun scripts/gen-experience-frame-runtime.ts",
    "db:push": "bun run --filter @vibe-tavern/db db:push",
    "bump-version": "bun scripts/bump-version.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "bun-plugin-tailwind": "^0.1.2",
    "typescript": "7.1.0-dev.20260912.1"
  },
  "dependencies": {
    "hono": "^4.13.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Noineri/vibe_tavern"
  },
  "license": "AGPL-3.0"
}
