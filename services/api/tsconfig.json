{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Server-only code: pin lib to ESNext WITHOUT DOM (the base's missing
    // "lib" derives esnext.full, which bundles DOM and hides node's global
    // ReadableStream aliasing from bun-types).
    "lib": [
      "ESNext"
    ],
    "types": [
      "bun"
    ],
    "paths": {
      "@vibe-tavern/api-contracts": [
        "../../packages/api-contracts/src/index.ts"
      ],
      "@vibe-tavern/db": [
        "../../packages/db/src/index.ts"
      ],
      "@vibe-tavern/domain": [
        "../../packages/domain/src/index.ts"
      ],
      "@vibe-tavern/domain/tetris-port": [
        "../../packages/domain/src/experience-tetris-port.ts"
      ],
      "@vibe-tavern/domain/builtins": [
        "../../packages/domain/src/builtin-experiences.ts"
      ],
      "@vibe-tavern/import-export": [
        "../../packages/import-export/src/index.ts"
      ],
      "@vibe-tavern/prompt-pipeline": [
        "../../packages/prompt-pipeline/src/index.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ]
}
