<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.VibeTavern" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:fontFamily">@font/inter_variable</item>
        <item name="fontFamily">@font/inter_variable</item>
        <item name="android:statusBarColor">@color/vt_background</item>
        <item name="android:navigationBarColor">@color/vt_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="colorPrimary">@color/vt_accent</item>
        <item name="colorPrimaryVariant">@color/vt_accent_mid</item>
        <item name="colorOnPrimary">@color/vt_on_accent</item>
        <item name="android:colorBackground">@color/vt_background</item>
        <item name="colorSurface">@color/vt_surface</item>
        <item name="colorOnSurface">@color/vt_text_primary</item>
    </style>

    <style name="Widget.VibeTavern.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/vt_accent</item>
        <item name="android:textColor">@color/vt_on_accent</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="Widget.VibeTavern.Button.Secondary" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/vt_text_primary</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
