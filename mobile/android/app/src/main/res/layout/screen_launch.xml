<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vt_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="144dp"
            android:layout_height="88dp"
            android:layout_marginBottom="10dp"
            android:contentDescription="@string/logo_content_description"
            android:src="@drawable/vt_logo" />

        <TextView
            android:id="@+id/launch_product_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/alegreya_variable"
            android:gravity="center"
            android:text="@string/app_name"
            android:textColor="@color/vt_text_primary"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/launch_intro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:gravity="center"
            android:text="@string/launcher_intro"
            android:textColor="@color/vt_text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/launcher_version_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@color/vt_surface"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:padding="12dp"
            android:text="@string/launcher_version_status"
            android:textColor="@color/vt_text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@color/vt_surface_raised"
            android:gravity="center"
            android:padding="16dp"
            android:text="@string/checking_server"
            android:textColor="@color/vt_text_primary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/progress_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:gravity="center"
            android:textColor="@color/vt_text_secondary"
            android:textSize="14sp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginBottom="22dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/vt_accent"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_launch_server"
            style="@style/Widget.VibeTavern.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:minHeight="56dp"
            android:text="@string/start_server"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btn_open_browser"
            style="@style/Widget.VibeTavern.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:minHeight="52dp"
            android:text="@string/open_browser"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btn_stop_server"
            style="@style/Widget.VibeTavern.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:minHeight="48dp"
            android:text="@string/stop_server"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/management_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:gravity="center"
            android:text="@string/management"
            android:textColor="@color/vt_text_muted"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_check_launcher_update"
            style="@style/Widget.VibeTavern.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:minHeight="48dp"
            android:text="@string/check_launcher_update"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_first_time_setup"
            style="@style/Widget.VibeTavern.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:minHeight="48dp"
            android:text="@string/first_time_setup"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_one_time_setup"
            style="@style/Widget.VibeTavern.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:minHeight="48dp"
            android:text="@string/install_server"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_help"
            style="@style/Widget.VibeTavern.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:minHeight="48dp"
            android:text="@string/help_troubleshooting"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_language"
            style="@style/Widget.VibeTavern.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:minHeight="48dp"
            android:text="@string/language"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_uninstall"
            style="@style/Widget.VibeTavern.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:minHeight="48dp"
            android:text="@string/uninstall"
            android:textColor="@color/vt_destructive"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/help_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="@string/battery_hint"
            android:textColor="@color/vt_text_muted"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
