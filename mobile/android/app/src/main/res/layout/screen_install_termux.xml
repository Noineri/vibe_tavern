<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vt_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="28dp">

        <ImageView
            android:layout_width="144dp"
            android:layout_height="88dp"
            android:contentDescription="@string/logo_content_description"
            android:src="@drawable/vt_logo" />

        <TextView
            android:id="@+id/termux_product_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/alegreya_variable"
            android:gravity="center"
            android:text="@string/app_name"
            android:textColor="@color/vt_text_primary"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/termux_step_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="22dp"
            android:gravity="center"
            android:text="@string/step_install_termux"
            android:textColor="@color/vt_text_secondary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/termux_install_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:background="@color/vt_surface"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:padding="16dp"
            android:text="@string/termux_install_body"
            android:textColor="@color/vt_text_primary"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_install_termux"
            style="@style/Widget.VibeTavern.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:minHeight="56dp"
            android:text="@string/btn_install_termux"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btn_check_again"
            style="@style/Widget.VibeTavern.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/btn_installed_continue"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
